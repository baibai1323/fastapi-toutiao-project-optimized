# 复制本文件为 .env 后再改值：copy env.example .env
# 注意：.env 已被 .gitignore 忽略，绝对不要提交真实密码/Key。

APP_NAME=XWZX News API
DEBUG=false

# MySQL 8；密码里有 @/: 等字符时要做 URL 编码
DATABASE_URL=mysql+aiomysql://root:your_password@127.0.0.1:3306/news_app?charset=utf8mb4
SQL_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TIMEOUT=1.0

# 多个来源用英文逗号分隔；生产不要写 *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

TOKEN_TTL_DAYS=7
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=300

# 阿里云百炼 / DashScope
# Key 留空时默认开启演示模式：返回预设 SSE，不调用真实模型、不产生费用。
# 填了 Key 后自动走真实模型；AI_MOCK_MODE=false 可在无 Key 时改为返回 503。
DASHSCOPE_API_KEY=
DASHSCOPE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AI_MOCK_MODE=true
AI_RATE_LIMIT=30
AI_RATE_WINDOW=3600
AI_ALLOWED_MODELS=qwen-plus,qwen-turbo,qwen-max
